# Copie para .env para alterar credenciais ou portas (opcional).
POSTGRES_DB=gobeach
POSTGRES_USER=gobeach
POSTGRES_PASSWORD=gobeach
DB_PORT=5432
API_PORT=3000
WEB_PORT=8080

# PBI-06: com true, aulas cadastradas ficam ocultas até aprovação
# (PATCH /api/atividades/:id/publicacao com o cabeçalho X-Admin-Token).
MODERAR_CADASTROS=false
ADMIN_TOKEN=

# PBI-11: recuperação de senha por e-mail.
# Por padrão os e-mails vão para o Mailpit (http://localhost:8025).
# Para enviar de verdade, aponte para um servidor SMTP real.
APP_URL=http://localhost:8080
MAIL_WEB_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=GoBeach <nao-responda@gobeach.dev>
